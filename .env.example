# ── Google Gemini ────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get all values from: Supabase Dashboard → your project → Settings → API

# Project URL  (e.g. https://xyzxyz.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Service role key — bypasses RLS so the backend can read/write all tables.
# Get from: Settings → API → "service_role" (labelled "secret")
# KEEP THIS PRIVATE — never expose it to clients.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# anon/public key — keep for auth.py JWT lookup (families SELECT)
ANON_PUBLIC_KEY=your_supabase_anon_key_here

# JWT secret — used to verify Bearer tokens from the iOS app
# Get from: Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
